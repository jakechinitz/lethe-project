DATABASE_URL=postgres://postgres:dev@localhost/postgres
BIND_ADDR=127.0.0.1:8080
DEFAULT_BOARD_POW_BITS=18
# 32-byte Ed25519 federation identity seed. Auto-created on first boot,
# mode 0600. For prod, set to /var/lib/lethe/server-key (root-owned dir,
# lethe-user-owned file). Never commit the contents.
LETHE_SERVER_KEY_PATH=./server-key
# Keep tower_http below info: request URIs carry invite codes and room/
# thread ids, so request-level tracing would log secrets. See lib::router.
RUST_LOG=lethe_server=info,tower_http=warn
